# Supabase (project: rashid-hq-os)
# The browser never talks to Supabase directly — activity streams over
# /api/activity/stream instead — so no publishable key is needed.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string used by Better Auth (Supabase > Project Settings > Database)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Better Auth
BETTER_AUTH_SECRET=
# Must be the real origin in production, or sessions break.
BETTER_AUTH_URL=http://localhost:3000

# Single-owner console. Comma-separated allowlist; enforced at sign-up and on
# every guarded page. Leave empty and nobody can sign up or sign in.
OWNER_EMAILS=

# Vercel AI Gateway (CEO console)
AI_GATEWAY_API_KEY=
CEO_CONSOLE_MODEL=anthropic/claude-sonnet-5

# Development only: lets call_project_tool reach http:// and private addresses.
# Never set this in production — it disables the SSRF guard.
# ALLOW_PRIVATE_MCP_ENDPOINTS=1
