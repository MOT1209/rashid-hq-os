{
  "name": "rashid-hq-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 7070",
    "build": "next build",
    "start": "next start -p 7070",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth:migrate": "node --env-file=.env.local scripts/auth-migrate.mjs",
    "migrate:status": "node --env-file=.env.local scripts/migrate.mjs status",
    "migrate:baseline": "node --env-file=.env.local scripts/migrate.mjs baseline",
    "migrate:dry-run": "node --env-file=.env.local scripts/migrate.mjs dry-run",
    "migrate:apply": "node --env-file=.env.local scripts/migrate.mjs apply",
    "migrate:from-scratch": "node --env-file-if-exists=.env.local scripts/migrate.mjs apply --from-scratch",
    "seed:owner": "node scripts/seed-owner.mjs",
    "db:backup": "node --env-file=.env.local scripts/pre-migrate-backup.mjs",
    "test:e2e": "node tests/e2e/smoke.mjs"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.31",
    "@ai-sdk/react": "^4.0.68",
    "@sentry/nextjs": "^10.78.0",
    "@supabase/supabase-js": "^2.58.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "ai": "^7.0.65",
    "better-auth": "^1.7.25",
    "lucide-react": "^0.500.0",
    "mcp-handler": "^2.4.0",
    "next": "16.4.6",
    "pg": "^8.13.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "comments": {
    "overrides": "@ai-sdk/react pins an exact `ai` version, so a caret range here lets npm install a second copy. The CEO console builds a DefaultChatTransport from `ai` and hands it to useChat from @ai-sdk/react — two copies means two incompatible module instances across that boundary. This forces one."
  },
  "overrides": {
    "ai": "$ai",
    "@modelcontextprotocol/server": "^2.3.0",
    "vite": "^8.3.8",
    "source-map-js": "^1.2.2",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.11.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
