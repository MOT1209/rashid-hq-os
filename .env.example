# Supabase (project: rashid-hq-os)
# The browser never talks to Supabase directly — activity streams over
# /api/activity/stream instead — so no publishable key is needed.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string used by Better Auth (Supabase > Project Settings > Database)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Better Auth
BETTER_AUTH_SECRET=
# The canonical origin. On Vercel this is derived from VERCEL_URL when unset,
# and preview deployments are trusted automatically — so you only need to set
# this once you have a custom domain.
BETTER_AUTH_URL=http://localhost:7070
# Any additional origins allowed to sign in, comma separated. Only needed for
# a custom domain; localhost and *.vercel.app are handled for you.
# TRUSTED_ORIGINS=https://hq.example.com

# Single-owner console. Comma-separated allowlist; enforced at sign-up and on
# every guarded page. Leave empty and nobody can sign up or sign in.
# (Surrounding quotes are tolerated, but don't add them.)
OWNER_EMAILS=

# Set to any value to require two-factor auth for every write (server actions +
# the CEO console). Reads still work without it, and Settings stays reachable to
# enable 2FA. Unset it to break the glass.
# REQUIRE_2FA=1

# Vercel AI Gateway (CEO console)
# Free from https://console.groq.com/keys — no credit card required.
GROQ_API_KEY=
# Optional; defaults to a model picked for tool calling.
GROQ_MODEL=

# Development only: lets call_project_tool reach http:// and private addresses.
# Never set this in production — it disables the SSRF guard.
# ALLOW_PRIVATE_MCP_ENDPOINTS=1

# Keys the agent-token digests. Optional: without it tokens are stored as a
# bare SHA-256, which is sound for 256-bit random tokens but unkeyed. Set it and
# existing tokens keep working — each is re-hashed the next time it is used.
#   openssl rand -base64 32
TOKEN_PEPPER=

# Shared with each project MCP server so it can verify calls really came from
# here. Optional: unset means unsigned, as before.
#   openssl rand -base64 32
OUTBOUND_SIGNING_SECRET=

# Transactional email (Resend, via the Vercel Marketplace integration — that
# sets RESEND_API_KEY for you). Without it, password reset silently does not
# send and everything else keeps working.
RESEND_API_KEY=
# Must be a domain verified in Resend. The default only delivers to the
# Resend account owner, which is enough for testing.
# EMAIL_FROM=Alking Enterprises <hq@yourdomain.com>

# Error tracking + tracing (Sentry, @sentry/nextjs). Optional: without a DSN the
# SDK is a no-op — errors still get a reference id and a server log.
# Create a Next.js project at sentry.io; the DSN is the same string for both.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for source-map upload so production stack traces are readable.
# Sentry > Settings > Auth Tokens. Without it the build still succeeds, traces
# are just minified. Keep it out of git.
SENTRY_AUTH_TOKEN=
# Org and project slugs, used by withSentryConfig for source-map upload.
SENTRY_ORG=
SENTRY_PROJECT=

# Nightly log pruning (Vercel Cron sends this as a bearer token).
CRON_SECRET=
# Activity retention window; anything older is deleted. Default 90 days.
# LOG_RETENTION=90 days

# ─────────────────────────────────────────────────────────────────────────────
# Integrations (/dashboard/settings/integrations)
# ─────────────────────────────────────────────────────────────────────────────
# Encryption at rest for every stored OAuth token and API key. Required before
# any credential-storing integration can be connected. Generate:
#   openssl rand -base64 32
INTEGRATIONS_SECRET=

# Google OAuth 2.0 — one Cloud OAuth client backs google / youtube / gmail /
# drive / calendar / search_console. Console: https://console.cloud.google.com/
# Authorized redirect URI (add one per provider you enable):
#   https://YOUR_DOMAIN/api/integrations/google/callback
#   https://YOUR_DOMAIN/api/integrations/youtube/callback   (etc.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App — https://github.com/settings/developers
# Callback: https://YOUR_DOMAIN/api/integrations/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Webhook payload secret (Repo/Org → Settings → Webhooks). Deliveries without a
# valid X-Hub-Signature-256 are rejected by /api/webhooks/github.
GITHUB_WEBHOOK_SECRET=

# API-key providers are connected from the UI (the key is pasted, tested, then
# sealed) — no env var needed. These are only listed here for reference:
#   OpenAI     https://platform.openai.com/api-keys
#   Anthropic  https://console.anthropic.com/settings/keys
#   Gemini     https://aistudio.google.com/apikey
#   Clarity    project ID from https://clarity.microsoft.com/

# Planned providers (registry stubs today — set when wired up):
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# TELEGRAM_BOT_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_ENGINE_ID=
