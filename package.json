{
  "name": "rashid-hq-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 7070",
    "build": "next build",
    "start": "next start -p 7070",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth:migrate": "node --env-file=.env.local scripts/auth-migrate.mjs",
    "seed:owner": "node scripts/seed-owner.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.68",
    "@supabase/supabase-js": "^2.58.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "ai": "^7.0.65",
    "better-auth": "^1.3.0",
    "lucide-react": "^0.500.0",
    "mcp-handler": "^2.1.1",
    "next": "16.3.1",
    "pg": "^8.13.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "undici": "^7.29.0",
    "zod": "^4.1.8"
  },
  "comments": {
    "overrides": "@ai-sdk/react pins an exact `ai` version, so a caret range here lets npm install a second copy. The CEO console builds a DefaultChatTransport from `ai` and hands it to useChat from @ai-sdk/react — two copies means two incompatible module instances across that boundary. This forces one."
  },
  "overrides": {
    "ai": "$ai"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.11.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
